{
  "name": "akash-tunnel-mapper",
  "productName": "AKASH TUNNEL MAPPER",
  "description": "Underground Geological & Geotechnical Tunnel Mapping Desktop Engineering Suite",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.js",
  "author": "AKASH TUNNEL MAPPER Engineering",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node --import tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "icon": "node scripts/generate-win-icon.mjs",
    "electron": "vite build && electron .",
    "electron:dev": "electron .",
    "pack": "node scripts/generate-win-icon.mjs && vite build && electron-builder --config electron-builder.json --dir",
    "build:win": "node scripts/generate-win-icon.mjs && vite build && electron-builder --config electron-builder.json --win",
    "build:electron": "node scripts/generate-win-icon.mjs && vite build && electron-builder --config electron-builder.json --win nsis",
    "dist": "node scripts/generate-win-icon.mjs && vite build && electron-builder --config electron-builder.json --win nsis",
    "clean": "rm -rf dist release server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^1.3.0"
  },
  "build": {
    "appId": "com.akash.tunnelmapper",
    "productName": "AKASH TUNNEL MAPPER",
    "copyright": "Copyright © 2026 AKASH TUNNEL MAPPER Engineering Suite",
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.ico",
      "package.json",
      "!node_modules/**/*"
    ],
    "fileAssociations": [
      {
        "ext": [
          "akash",
          "atmp",
          "json"
        ],
        "name": "AKASH Tunnel Mapping Project",
        "description": "AKASH TUNNEL MAPPER Geological Project File",
        "role": "Editor",
        "icon": "build/icon.ico"
      },
      {
        "ext": [
          "dxf",
          "dwg"
        ],
        "name": "CAD Tunnel Profile",
        "description": "AutoCAD DXF/DWG Tunnel Excavation Profile",
        "role": "Viewer",
        "icon": "build/icon.ico"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "AKASH-TUNNEL-MAPPER-Setup.exe",
      "executableName": "AKASH TUNNEL MAPPER"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AKASH TUNNEL MAPPER",
      "uninstallDisplayName": "AKASH TUNNEL MAPPER",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  }
}
